{
  "name": "ai-trading-analysis",
  "version": "1.0.0",
  "description": "AI-powered stock trading analysis website with Gemini integration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "webpack --mode production",
    "client": "cd client && npm start",
    "server": "nodemon server.js",
    "dev:full": "concurrently \"npm run server\" \"npm run client\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "axios": "^1.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "@google/generative-ai": "^0.1.3",
    "ws": "^8.14.2",
    "node-cron": "^3.0.2",
    "technicalindicators": "^3.1.0",
    "moment": "^2.29.4",
    "helmet": "^7.0.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^6.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.0",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  },
  "keywords": [
    "trading",
    "ai",
    "gemini",
    "stock-analysis",
    "real-time",
    "technical-analysis"
  ],
  "author": "AI Trading Team",
  "license": "MIT"
}